  <diagram id="wish-create-flow" name="やりたいこと登録フロー">
    <mxGraphModel dx="1422" dy="762" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Swim Lane: Frontend -->
        <mxCell id="lane_fe" value="Frontend (WishForm.js)" style="shape=swimlane;startSize=30;fillColor=#E3F2FD;strokeColor=#1565C0;fontStyle=1;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="40" y="40" width="500" height="1060" as="geometry" />
        </mxCell>

        <!-- Swim Lane: Backend -->
        <mxCell id="lane_be" value="Backend (routes/wishes.js)" style="shape=swimlane;startSize=30;fillColor=#E8F5E9;strokeColor=#2E7D32;fontStyle=1;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="580" y="40" width="500" height="1060" as="geometry" />
        </mxCell>

        <!-- Swim Lane: Database -->
        <mxCell id="lane_db" value="Database (MySQL)" style="shape=swimlane;startSize=30;fillColor=#FFF3E0;strokeColor=#E65100;fontStyle=1;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="1120" y="40" width="420" height="1060" as="geometry" />
        </mxCell>

        <!-- FE: Start -->
        <mxCell id="n1" value="ユーザーがフォーム入力&#xa;(タイトル, ステータス, 優先度,&#xa;期限, タグ, メモ, 画像)" style="rounded=1;whiteSpace=wrap;fillColor=#BBDEFB;strokeColor=#1565C0;" vertex="1" parent="lane_fe">
          <mxGeometry x="100" y="60" width="300" height="70" as="geometry" />
        </mxCell>

        <!-- FE: Submit -->
        <mxCell id="n2" value="handleSubmit() 実行" style="rounded=0;whiteSpace=wrap;fillColor=#FFF3E0;strokeColor=#E65100;" vertex="1" parent="lane_fe">
          <mxGeometry x="130" y="160" width="240" height="40" as="geometry" />
        </mxCell>

        <!-- FE: Title check -->
        <mxCell id="n3" value="タイトル空？" style="rhombus;whiteSpace=wrap;fillColor=#FFF9C4;strokeColor=#F57F17;" vertex="1" parent="lane_fe">
          <mxGeometry x="160" y="230" width="180" height="60" as="geometry" />
        </mxCell>

        <!-- FE: Error -->
        <mxCell id="n4" value="エラー表示&#xa;'タイトルは必須です'" style="rounded=0;whiteSpace=wrap;fillColor=#FFCDD2;strokeColor=#C62828;" vertex="1" parent="lane_fe">
          <mxGeometry x="10" y="240" width="130" height="50" as="geometry" />
        </mxCell>

        <!-- FE: Fetch POST -->
        <mxCell id="n5" value="fetch() POST /api/wishes&#xa;Content-Type: application/json&#xa;credentials: 'include'&#xa;body: {title, status, priority,&#xa;  description, due_date, tags}" style="rounded=0;whiteSpace=wrap;fillColor=#FFF3E0;strokeColor=#E65100;" vertex="1" parent="lane_fe">
          <mxGeometry x="100" y="320" width="300" height="90" as="geometry" />
        </mxCell>

        <!-- FE: onSave -->
        <mxCell id="n20" value="onSave(savedWish)&#xa;一覧を更新" style="rounded=0;whiteSpace=wrap;fillColor=#BBDEFB;strokeColor=#1565C0;" vertex="1" parent="lane_fe">
          <mxGeometry x="130" y="770" width="240" height="50" as="geometry" />
        </mxCell>

        <!-- FE: Image check -->
        <mxCell id="n21" value="pendingFiles&#xa;あり？" style="rhombus;whiteSpace=wrap;fillColor=#FFF9C4;strokeColor=#F57F17;" vertex="1" parent="lane_fe">
          <mxGeometry x="160" y="850" width="180" height="60" as="geometry" />
        </mxCell>

        <!-- FE: Image upload -->
        <mxCell id="n22" value="POST /api/wishes/:id/images&#xa;multipart/form-data&#xa;(1枚ずつアップロード)" style="rounded=0;whiteSpace=wrap;fillColor=#FFF3E0;strokeColor=#E65100;" vertex="1" parent="lane_fe">
          <mxGeometry x="100" y="940" width="300" height="60" as="geometry" />
        </mxCell>

        <!-- FE: Done -->
        <mxCell id="n23" value="完了&#xa;WishList 再描画" style="rounded=1;whiteSpace=wrap;fillColor=#C8E6C9;strokeColor=#2E7D32;" vertex="1" parent="lane_fe">
          <mxGeometry x="370" y="860" width="120" height="50" as="geometry" />
        </mxCell>

        <!-- BE: requireAuth -->
        <mxCell id="n6" value="requireAuth&#xa;ミドルウェア" style="rounded=0;whiteSpace=wrap;fillColor=#F3E5F5;strokeColor=#6A1B9A;" vertex="1" parent="lane_be">
          <mxGeometry x="140" y="330" width="220" height="50" as="geometry" />
        </mxCell>

        <!-- BE: Auth fail -->
