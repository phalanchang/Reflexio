        <!-- BE: Insert wish -->
        <mxCell id="n10" value="INSERT INTO wishes&#xa;(user_id, title, description,&#xa;status, priority, due_date)" style="rounded=0;whiteSpace=wrap;fillColor=#C8E6C9;strokeColor=#2E7D32;" vertex="1" parent="lane_be">
          <mxGeometry x="130" y="520" width="240" height="60" as="geometry" />
