<mxfile>
  <diagram name="Sprint 5 OAuth Settings" id="sprint05">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <!-- Lanes -->
        <mxCell id="lane1" value="ブラウザ (User)" style="shape=swimlane;startSize=30;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="20" y="20" width="300" height="780" as="geometry"/>
        </mxCell>
        <mxCell id="lane2" value="React (Frontend)" style="shape=swimlane;startSize=30;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="320" y="20" width="300" height="780" as="geometry"/>
        </mxCell>
        <mxCell id="lane3" value="Express (Backend)" style="shape=swimlane;startSize=30;fillColor=#ffe6cc;strokeColor=#d6b656;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="620" y="20" width="300" height="780" as="geometry"/>
        </mxCell>
        <mxCell id="lane4" value="MySQL (DB)" style="shape=swimlane;startSize=30;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="920" y="20" width="280" height="780" as="geometry"/>
        </mxCell>

        <!-- Flow nodes -->
        <mxCell id="n1" value="設定画面に遷移" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="lane1">
          <mxGeometry x="40" y="50" width="220" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="n2" value="Settings.js&#xa;OAuth設定セクション表示" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="lane2">
          <mxGeometry x="30" y="50" width="240" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="n3" value="GET /api/google/settings" style="rounded=1;fillColor=#ffe6cc;strokeColor=#d6b656;" vertex="1" parent="lane3">
          <mxGeometry x="30" y="120" width="240" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="n4" value="google_oauth_settings&#xa;SELECT" style="rounded=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="lane4">
          <mxGeometry x="20" y="120" width="240" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="n5" value="secretマスク処理&#xa;(先頭6文字+****)" style="rounded=1;fillColor=#ffe6cc;strokeColor=#d6b656;" vertex="1" parent="lane3">
          <mxGeometry x="30" y="190" width="240" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="n6" value="設定表示&#xa;(Client ID + マスク済Secret)" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="lane2">
          <mxGeometry x="30" y="190" width="240" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="n7" value="Client ID/Secret 入力&#xa;「保存」クリック" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="lane1">
          <mxGeometry x="40" y="280" width="220" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="n8" value="POST or PUT&#xa;/api/google/settings" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="lane2">
          <mxGeometry x="30" y="350" width="240" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="n9" value="バリデーション&#xa;INSERT or UPDATE" style="rounded=1;fillColor=#ffe6cc;strokeColor=#d6b656;" vertex="1" parent="lane3">
          <mxGeometry x="30" y="350" width="240" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="n10" value="google_oauth_settings&#xa;UPSERT (UNIQUE user_id)" style="rounded=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="lane4">
          <mxGeometry x="20" y="350" width="240" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="n11" value="保存成功トースト" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="lane2">
          <mxGeometry x="30" y="430" width="240" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="n12" value="GoogleConnect.js&#xa;設定未登録時: 案内表示&#xa;登録済み: 接続ボタン表示" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="lane2">
          <mxGeometry x="30" y="520" width="240" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="n13" value="createOAuth2Client&#xa;ユーザー設定優先&#xa;→環境変数フォールバック" style="rounded=1;fillColor=#ffe6cc;strokeColor=#d6b656;" vertex="1" parent="lane3">
          <mxGeometry x="30" y="520" width="240" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="n14" value="Dashboard.js&#xa;3状態分岐表示" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="lane2">
          <mxGeometry x="30" y="620" width="240" height="40" as="geometry"/>
        </mxCell>

        <!-- Arrows -->
        <mxCell id="a1" edge="1" source="n1" target="n2" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a2" value="fetch" edge="1" source="n2" target="n3" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a3" value="SELECT" edge="1" source="n3" target="n4" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a4" edge="1" source="n4" target="n5" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a5" value="マスク済レスポンス" edge="1" source="n5" target="n6" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a6" edge="1" source="n7" target="n8" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a7" value="POST/PUT" edge="1" source="n8" target="n9" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a8" value="INSERT/UPDATE" edge="1" source="n9" target="n10" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a9" value="success" edge="1" source="n10" target="n11" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a10" edge="1" source="n12" target="n13" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a11" edge="1" source="n13" target="n14" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
