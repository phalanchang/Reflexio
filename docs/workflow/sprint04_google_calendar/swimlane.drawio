        </mxCell>
        <mxCell id="n12" value="カテゴリ別日ごと集計&#xa;全日付埋め対応" style="rounded=1;fillColor=#ffe6cc;strokeColor=#d6b656;" vertex="1" parent="lane3">
          <mxGeometry x="10" y="725" width="240" height="40" as="geometry"/>
        </mxCell>
