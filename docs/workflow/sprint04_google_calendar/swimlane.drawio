          <mxGeometry x="10" y="785" width="240" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="n14" value="棒グラフ閲覧&#xa;期間切替(7日/週/月)" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="lane1">
          <mxGeometry x="10" y="845" width="240" height="40" as="geometry"/>
