<mxfile host="app.diagrams.net" modified="2026-03-06T00:00:00.000Z" agent="Claude" version="21.0.0">
  <diagram name="Sprint 4: Googleカレンダー連携" id="sprint04">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="lane1" value="ブラウザ (User)" style="shape=swimlane;startSize=30;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="20" y="20" width="260" height="900" as="geometry"/>
        </mxCell>
        <mxCell id="lane2" value="React (Frontend)" style="shape=swimlane;startSize=30;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="280" y="20" width="260" height="900" as="geometry"/>
        </mxCell>
        <mxCell id="lane3" value="Express (Backend)" style="shape=swimlane;startSize=30;fillColor=#ffe6cc;strokeColor=#d6b656;fontStyle=1;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="540" y="20" width="260" height="900" as="geometry"/>
        </mxCell>
        <mxCell id="lane4" value="MySQL (DB)" style="shape=swimlane;startSize=30;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="800" y="20" width="260" height="900" as="geometry"/>
        </mxCell>
        <mxCell id="lane5" value="Google API" style="shape=swimlane;startSize=30;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="1060" y="20" width="260" height="900" as="geometry"/>
        </mxCell>
        <!-- OAuth認証 -->
        <mxCell id="n1" value="「カレンダーを接続」&#xa;ボタン押下" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="lane1">
          <mxGeometry x="10" y="50" width="240" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="n2" value="GET /api/google/auth-url" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="lane2">
          <mxGeometry x="10" y="110" width="240" height="35" as="geometry"/>
        </mxCell>
        <mxCell id="n3" value="OAuth2Client&#xa;認証URL生成" style="rounded=1;fillColor=#ffe6cc;strokeColor=#d6b656;" vertex="1" parent="lane3">
          <mxGeometry x="10" y="165" width="240" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="n4" value="Google同意画面&#xa;ユーザーが許可" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="lane1">
          <mxGeometry x="10" y="225" width="240" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="n5" value="GoogleCallback&#xa;code取得 → POST callback" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="lane2">
          <mxGeometry x="10" y="285" width="240" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="n6" value="code→token交換&#xa;google_tokens保存" style="rounded=1;fillColor=#ffe6cc;strokeColor=#d6b656;" vertex="1" parent="lane3">
          <mxGeometry x="10" y="345" width="240" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="n7" value="INSERT google_tokens&#xa;(access/refresh/expires)" style="rounded=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="lane4">
          <mxGeometry x="10" y="405" width="240" height="40" as="geometry"/>
        </mxCell>
        <!-- 棒グラフ表示 -->
        <mxCell id="n8" value="Dashboard表示&#xa;GET /api/google/status" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="lane2">
          <mxGeometry x="10" y="490" width="240" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="n9" value="GET /api/calendar/summary&#xa;?period=7d" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="lane2">
          <mxGeometry x="10" y="550" width="240" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="n10" value="token取得 → Calendar API" style="rounded=1;fillColor=#ffe6cc;strokeColor=#d6b656;" vertex="1" parent="lane3">
          <mxGeometry x="10" y="610" width="240" height="35" as="geometry"/>
        </mxCell>
        <mxCell id="n11" value="events.list()&#xa;イベント一覧返却" style="rounded=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="lane5">
