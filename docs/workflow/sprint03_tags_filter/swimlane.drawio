<mxfile host="app.diagrams.net" modified="2026-03-06T00:00:00.000Z" agent="Claude" version="21.0.0">
  <diagram name="Sprint 3: タグ+フィルタ" id="sprint03">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="lane1" value="ブラウザ (User)" style="shape=swimlane;startSize=30;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="20" y="20" width="280" height="780" as="geometry"/>
        </mxCell>
        <mxCell id="lane2" value="React (Frontend)" style="shape=swimlane;startSize=30;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="300" y="20" width="280" height="780" as="geometry"/>
        </mxCell>
        <mxCell id="lane3" value="Express (Backend)" style="shape=swimlane;startSize=30;fillColor=#ffe6cc;strokeColor=#d6b656;fontStyle=1;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="580" y="20" width="280" height="780" as="geometry"/>
        </mxCell>
        <mxCell id="lane4" value="MySQL (DB)" style="shape=swimlane;startSize=30;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="860" y="20" width="280" height="780" as="geometry"/>
        </mxCell>
        <!-- タグ付き作成 -->
        <mxCell id="n1" value="WishForm: タイトル +&#xa;タグ名(カンマ区切り)入力" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="lane1">
          <mxGeometry x="20" y="50" width="240" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="n2" value="POST /api/wishes&#xa;{title, tags: [...] }" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="lane2">
          <mxGeometry x="20" y="110" width="240" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="n3" value="wish INSERT&#xa;+ タグループ処理" style="rounded=1;fillColor=#ffe6cc;strokeColor=#d6b656;" vertex="1" parent="lane3">
          <mxGeometry x="20" y="170" width="240" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="n4" value="INSERT wishes&#xa;INSERT IGNORE tags&#xa;INSERT wish_tags" style="rounded=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="lane4">
          <mxGeometry x="20" y="230" width="240" height="50" as="geometry"/>
        </mxCell>
        <!-- 一覧(タグ付き) -->
        <mxCell id="n5" value="WishList 表示" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="lane2">
          <mxGeometry x="20" y="320" width="240" height="35" as="geometry"/>
        </mxCell>
        <mxCell id="n6" value="GET /api/wishes&#xa;+ タグ一括取得(N+1回避)" style="rounded=1;fillColor=#ffe6cc;strokeColor=#d6b656;" vertex="1" parent="lane3">
          <mxGeometry x="20" y="375" width="240" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="n7" value="SELECT wishes&#xa;+ JOIN wish_tags, tags&#xa;(IN句バッチ)" style="rounded=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="lane4">
          <mxGeometry x="20" y="435" width="240" height="50" as="geometry"/>
        </mxCell>
        <!-- フィルタ -->
        <mxCell id="n8" value="WishFilter: タグバッジ&#xa;+ 優先度を選択" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="lane1">
          <mxGeometry x="20" y="530" width="240" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="n9" value="クライアントサイドフィルタ&#xa;タグ(OR) AND 優先度(OR)" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="lane2">
          <mxGeometry x="20" y="590" width="240" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="n10" value="フィルタ結果を表示" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="lane1">
          <mxGeometry x="20" y="660" width="240" height="35" as="geometry"/>
