<mxfile>
  <diagram name="Sprint 6 Category" id="sprint06">
    <mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <!-- Lanes -->
        <mxCell id="lane1" value="ブラウザ (User)" style="shape=swimlane;startSize=30;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="20" y="20" width="260" height="780" as="geometry"/>
        </mxCell>
        <mxCell id="lane2" value="React (Frontend)" style="shape=swimlane;startSize=30;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="280" y="20" width="280" height="780" as="geometry"/>
        </mxCell>
        <mxCell id="lane3" value="Express (Backend)" style="shape=swimlane;startSize=30;fillColor=#ffe6cc;strokeColor=#d6b656;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="560" y="20" width="280" height="780" as="geometry"/>
        </mxCell>
        <mxCell id="lane4" value="MySQL (DB)" style="shape=swimlane;startSize=30;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="840" y="20" width="250" height="780" as="geometry"/>
        </mxCell>
        <mxCell id="lane5" value="Google Calendar API" style="shape=swimlane;startSize=30;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="1090" y="20" width="250" height="780" as="geometry"/>
        </mxCell>

        <!-- カテゴリ設定フロー -->
        <mxCell id="n1" value="設定画面 →&#xa;カテゴリ設定セクション" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="lane1">
          <mxGeometry x="20" y="50" width="220" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="n2" value="Settings.js&#xa;11色マッピングテーブル表示" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="lane2">
          <mxGeometry x="20" y="50" width="240" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="n3" value="GET /api/category-mappings" style="rounded=1;fillColor=#ffe6cc;strokeColor=#d6b656;" vertex="1" parent="lane3">
          <mxGeometry x="20" y="120" width="240" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="n4" value="category_mappings&#xa;SELECT by user_id" style="rounded=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="lane4">
          <mxGeometry x="10" y="120" width="230" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="n5" value="各色にカテゴリ名入力&#xa;「保存」クリック" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="lane1">
          <mxGeometry x="20" y="210" width="220" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="n6" value="PUT /api/category-mappings&#xa;一括更新" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="lane2">
          <mxGeometry x="20" y="280" width="240" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="n7" value="各colorId UPSERT&#xa;(INSERT ON DUPLICATE)" style="rounded=1;fillColor=#ffe6cc;strokeColor=#d6b656;" vertex="1" parent="lane3">
          <mxGeometry x="20" y="280" width="240" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="n8" value="category_mappings&#xa;UPSERT" style="rounded=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="lane4">
          <mxGeometry x="10" y="280" width="230" height="40" as="geometry"/>
        </mxCell>

        <!-- 分類表示フロー -->
        <mxCell id="n9" value="Dashboard表示" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="lane2">
          <mxGeometry x="20" y="400" width="240" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="n10" value="GET /api/calendar/summary&#xa;colorIdベース分類" style="rounded=1;fillColor=#ffe6cc;strokeColor=#d6b656;" vertex="1" parent="lane3">
          <mxGeometry x="20" y="400" width="240" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="n11" value="イベント取得&#xa;(colorId含む)" style="rounded=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="lane5">
          <mxGeometry x="15" y="400" width="220" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="n12" value="カスタム名取得&#xa;(未設定時はデフォルト色名)" style="rounded=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="lane4">
          <mxGeometry x="10" y="480" width="230" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="n13" value="カテゴリ別サマリー返却" style="rounded=1;fillColor=#ffe6cc;strokeColor=#d6b656;" vertex="1" parent="lane3">
          <mxGeometry x="20" y="560" width="240" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="n14" value="TimeChart.js&#xa;カテゴリ別積み上げ棒グラフ" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="lane2">
          <mxGeometry x="20" y="560" width="240" height="40" as="geometry"/>
        </mxCell>

        <!-- Arrows -->
        <mxCell id="a1" edge="1" source="n1" target="n2" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a2" value="fetch" edge="1" source="n2" target="n3" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a3" edge="1" source="n3" target="n4" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a4" edge="1" source="n5" target="n6" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a5" edge="1" source="n6" target="n7" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a6" edge="1" source="n7" target="n8" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a7" edge="1" source="n9" target="n10" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a8" edge="1" source="n10" target="n11" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a9" edge="1" source="n10" target="n12" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a10" edge="1" source="n12" target="n13" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a11" edge="1" source="n13" target="n14" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
