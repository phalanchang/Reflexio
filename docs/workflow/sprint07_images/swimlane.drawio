<mxfile>
  <diagram name="Sprint 7 Images" id="sprint07">
    <mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <!-- Lanes -->
        <mxCell id="lane1" value="ブラウザ (User)" style="shape=swimlane;startSize=30;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="20" y="20" width="280" height="880" as="geometry"/>
        </mxCell>
        <mxCell id="lane2" value="React (Frontend)" style="shape=swimlane;startSize=30;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="300" y="20" width="300" height="880" as="geometry"/>
        </mxCell>
        <mxCell id="lane3" value="Express (Backend)" style="shape=swimlane;startSize=30;fillColor=#ffe6cc;strokeColor=#d6b656;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="600" y="20" width="300" height="880" as="geometry"/>
        </mxCell>
        <mxCell id="lane4" value="MySQL (DB)" style="shape=swimlane;startSize=30;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="900" y="20" width="250" height="880" as="geometry"/>
        </mxCell>
        <mxCell id="lane5" value="ファイルシステム" style="shape=swimlane;startSize=30;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="1150" y="20" width="250" height="880" as="geometry"/>
        </mxCell>

        <!-- アップロードフロー -->
        <mxCell id="n1" value="Ctrl+V ペースト&#xa;or ファイル選択" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="lane1">
          <mxGeometry x="30" y="50" width="220" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="n2" value="WishForm.js&#xa;ペーストハンドラ&#xa;createObjectURL プレビュー" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="lane2">
          <mxGeometry x="30" y="50" width="240" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="n3" value="プレビュー表示&#xa;(サムネイル+削除ボタン)" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="lane2">
          <mxGeometry x="30" y="130" width="240" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="n4" value="wish保存後&#xa;POST /api/wishes/:wishId/images&#xa;(FormData multipart)" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="lane2">
          <mxGeometry x="30" y="210" width="240" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="n5" value="multer ミドルウェア&#xa;5MB上限, JPEG/PNG/GIF/WebP&#xa;5枚/wish上限チェック" style="rounded=1;fillColor=#ffe6cc;strokeColor=#d6b656;" vertex="1" parent="lane3">
          <mxGeometry x="30" y="210" width="240" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="n6" value="uploads/{user_id}/&#xa;ファイル保存" style="rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="lane5">
          <mxGeometry x="15" y="300" width="220" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="n7" value="wish_images&#xa;INSERT メタ情報" style="rounded=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="lane4">
          <mxGeometry x="10" y="300" width="230" height="40" as="geometry"/>
        </mxCell>

        <!-- 表示フロー -->
        <mxCell id="n8" value="WishList.js&#xa;サムネイル表示" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="lane2">
          <mxGeometry x="30" y="400" width="240" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="n9" value="GET /api/wishes/images/:id&#xa;認証+所有権チェック" style="rounded=1;fillColor=#ffe6cc;strokeColor=#d6b656;" vertex="1" parent="lane3">
          <mxGeometry x="30" y="400" width="240" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="n10" value="ファイルストリーム配信" style="rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="lane5">
          <mxGeometry x="15" y="400" width="220" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="n11" value="サムネイルクリック" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="lane1">
          <mxGeometry x="30" y="500" width="220" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="n12" value="ImageModal.js&#xa;全画面ビューア&#xa;(ESC/オーバーレイで閉じ)" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="lane2">
          <mxGeometry x="30" y="500" width="240" height="50" as="geometry"/>
        </mxCell>

        <!-- 削除フロー -->
        <mxCell id="n13" value="DELETE /api/wishes/images/:id" style="rounded=1;fillColor=#ffe6cc;strokeColor=#d6b656;" vertex="1" parent="lane3">
          <mxGeometry x="30" y="620" width="240" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="n14" value="ファイル削除" style="rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="lane5">
          <mxGeometry x="15" y="620" width="220" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="n15" value="wish_images DELETE&#xa;(wish削除時はCASCADE)" style="rounded=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="lane4">
          <mxGeometry x="10" y="620" width="230" height="40" as="geometry"/>
        </mxCell>

        <!-- Arrows -->
        <mxCell id="a1" edge="1" source="n1" target="n2" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a2" edge="1" source="n2" target="n3" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a3" edge="1" source="n3" target="n4" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a4" value="multipart" edge="1" source="n4" target="n5" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a5" edge="1" source="n5" target="n6" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a6" edge="1" source="n5" target="n7" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a7" value="fetch" edge="1" source="n8" target="n9" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a8" edge="1" source="n9" target="n10" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a9" edge="1" source="n11" target="n12" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a10" edge="1" source="n13" target="n14" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a11" edge="1" source="n13" target="n15" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
