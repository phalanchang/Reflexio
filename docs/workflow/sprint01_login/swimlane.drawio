<mxfile host="app.diagrams.net" modified="2026-03-06T00:00:00.000Z" agent="Claude" version="21.0.0">
  <diagram name="Sprint 1: ログイン認証フロー" id="sprint01">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <!-- レーン -->
        <mxCell id="lane1" value="ブラウザ (User)" style="shape=swimlane;startSize=30;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="20" y="20" width="300" height="820" as="geometry"/>
        </mxCell>
        <mxCell id="lane2" value="React (Frontend)" style="shape=swimlane;startSize=30;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="320" y="20" width="300" height="820" as="geometry"/>
        </mxCell>
        <mxCell id="lane3" value="Express (Backend)" style="shape=swimlane;startSize=30;fillColor=#ffe6cc;strokeColor=#d6b656;fontStyle=1;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="620" y="20" width="300" height="820" as="geometry"/>
        </mxCell>
        <mxCell id="lane4" value="MySQL (DB)" style="shape=swimlane;startSize=30;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="920" y="20" width="300" height="820" as="geometry"/>
        </mxCell>
        <!-- ログインフロー -->
        <mxCell id="n1" value="ユーザー名・パスワード入力" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="lane1">
          <mxGeometry x="30" y="60" width="240" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="n2" value="POST /api/auth/login&#xa;credentials: include" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="lane2">
          <mxGeometry x="30" y="120" width="240" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="n3" value="username で&#xa;ユーザー検索" style="rounded=1;fillColor=#ffe6cc;strokeColor=#d6b656;" vertex="1" parent="lane3">
          <mxGeometry x="30" y="180" width="240" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="n4" value="SELECT * FROM users&#xa;WHERE username = ?" style="rounded=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="lane4">
          <mxGeometry x="30" y="240" width="240" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="n5" value="bcrypt.compare()&#xa;パスワード照合" style="rounded=1;fillColor=#ffe6cc;strokeColor=#d6b656;" vertex="1" parent="lane3">
          <mxGeometry x="30" y="300" width="240" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="n6" value="req.session に&#xa;userId/username 保存" style="rounded=1;fillColor=#ffe6cc;strokeColor=#d6b656;" vertex="1" parent="lane3">
          <mxGeometry x="30" y="360" width="240" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="n7" value="user 情報を state に保存&#xa;/ にリダイレクト" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="lane2">
          <mxGeometry x="30" y="420" width="240" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="n8" value="ProtectedRoute:&#xa;GET /api/auth/me" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="lane2">
          <mxGeometry x="30" y="480" width="240" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="n9" value="セッション検証&#xa;user 情報を返却" style="rounded=1;fillColor=#ffe6cc;strokeColor=#d6b656;" vertex="1" parent="lane3">
          <mxGeometry x="30" y="540" width="240" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="n10" value="MainLayout 表示&#xa;(サイドバー + ヘッダー + コンテンツ)" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="lane2">
          <mxGeometry x="30" y="600" width="240" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="n11" value="メイン画面を閲覧" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="lane1">
          <mxGeometry x="30" y="660" width="240" height="40" as="geometry"/>
        </mxCell>
        <!-- ログアウト -->
        <mxCell id="n12" value="ログアウトボタン押下" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="lane1">
